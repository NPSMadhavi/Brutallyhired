# ---------- Core ----------
NODE_ENV=development
API_PORT=4000
# Public URL of the web app (used for redirects, email links, CORS)
WEB_ORIGIN=http://localhost:5173
# Public URL of the API (used for OIDC redirect URIs)
API_ORIGIN=http://localhost:4000
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=
SESSION_TTL_DAYS=14

# ---------- Database ----------
DATABASE_URL=postgresql://verity:verity@localhost:5432/verity?schema=public

# ---------- OIDC providers (leave a provider's client id empty to disable it) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common", "organizations", "consumers" or a tenant GUID
MICROSOFT_TENANT=common
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------- Email ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_CODE_TTL_MINUTES=10

# ---------- Files ----------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5
MAX_ONBOARDING_UPLOAD_MB=10
MAX_RECORDING_CHUNK_MB=25

# ---------- LiveKit (interviews) ----------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
INTERVIEW_JOIN_EARLY_MINUTES=10
INTERVIEW_JOIN_LATE_MINUTES=15

# ---------- AI resume reading (optional; OpenAI-compatible chat completions API) ----------
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
SCORING_RUBRIC_VERSION=rubric-v1

# ---------- Web (Vite) ----------
VITE_API_BASE=/api
VITE_DEFAULT_LOCALE=en
